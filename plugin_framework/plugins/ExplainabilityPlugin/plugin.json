{
    "name": "xai",
    "version": "0.1",
    "date": "2026-07-27",
    "entry_point": "plugin.ExplainabilityPlugin",
    "module": "plugins.explainability.plugin",
    "class": "ExplainabilityPlugin",
    "reference":{
        "author": "Karla Sam-Millan et al",
        "title": "Deep Learning Explainability for Breast Cancer Detection in Mammography",
        "year_of_publication": "2023",
        "github": "https://github.com/VICTORIA-project/Deep-Learning-Explainability-for-Breast-Cancer-Detection-in-Mammography",
        "weights_repository": "https://github.com/VICTORIA-project/Deep-Learning-Explainability-for-Breast-Cancer-Detection-in-Mammography"
    },
    "info": {
        "task": "classification",
        "input_type":"image",
        "output_type":"[class,score,heatmap]",
        "local_weights": ["./weights/best_model_resnet50_ft_full_1024.pth","./weights/best_model_efficientnetb0_full_1024_RSNA_OMIDB_crop.pth" ],
        "description":"Resnet and Efficientnet_b0 network for mammography image classification. The work can be extended to produce GradCAM heatmaps"
    },
    "docker":{
               "image":"preprocessing:xai:latest",
               "container_name":"preprocessing-xai",
               "GPU": "all",
               "docker_port": 8004
           },
    "comments":"no comments, so far"
}
